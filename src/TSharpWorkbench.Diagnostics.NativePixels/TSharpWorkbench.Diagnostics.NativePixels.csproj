<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TSharpWorkbench.Diagnostics.NativePixels</RootNamespace>
    <AssemblyName>TSharpWorkbench.Diagnostics.NativePixels</AssemblyName>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Layer C qualification: drives the real SDL drivers and reads back the pixels their
       renderers produced, through internal seams the SDL driver grants this assembly
       (InternalsVisibleTo). The driver gains no dependency on this project. -->
  <ItemGroup>
    <PackageReference Include="TSharpVision" />
    <PackageReference Include="TSharpVision.Drivers.SDL" />
    <!-- Reused driver-output fixtures (composite screen, update steps, resize, TVS1 loading) and VGA table. -->
    <ProjectReference Include="../TSharpWorkbench.Diagnostics.DriverOutput/TSharpWorkbench.Diagnostics.DriverOutput.csproj" />
    <ProjectReference Include="../TSharpWorkbench.Testing/TSharpWorkbench.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TSharpWorkbench.Diagnostics.NativePixels.Tests" />
  </ItemGroup>

  <ItemGroup><Compile Include="../WorkbenchPaths.cs" Link="WorkbenchPaths.cs" /></ItemGroup>
</Project>
