        "maxWidth": {
          "type": "integer",
          "minimum": 20,
          "maximum": 200
        },
        "maxHeight": {
          "type": "integer",
          "minimum": 6,
          "maximum": 100
        },
        "defaults": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}x[0-9]{1,3}$"
          }
        }
      },
      "required": [
        "minWidth",
        "minHeight",
        "maxWidth",
        "maxHeight",
        "defaults"
      ]
    },
